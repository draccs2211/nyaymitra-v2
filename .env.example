# Copy to .env and fill in. Never commit .env.

# ── Required ──────────────────────────────────────────────
SECRET_KEY=            # >= 32 random chars: python -c "import secrets; print(secrets.token_urlsafe(48))"
OPENAI_API_KEY=
DATABASE_URL=postgresql://user:password@localhost:5432/nyaymitra   # docker-compose sets this itself

# ── Environment ───────────────────────────────────────────
APP_ENV=development    # production | development | test (production is the default)
LOG_LEVEL=INFO
# LOG_FORMAT=json      # default json in production, text otherwise

# ── Optional services ─────────────────────────────────────
REDIS_URL=redis://localhost:6379
COHERE_API_KEY=        # reranking; without it results use RRF order
# COHERE_RERANK_MODEL=rerank-v5.0-fast
INDIAN_KANOON_API_KEY= # case-law discovery; without it research reports not_configured

# ── Tracing (LangSmith) ───────────────────────────────────
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_ALLOW_RAW_TRACES=false   # production hides inputs/outputs unless true

# ── Auth / onboarding ─────────────────────────────────────
# ALLOW_OPEN_SIGNUP=false            # default false in production (invite-only)
# ACCESS_TOKEN_EXPIRE_MINUTES=480
# CORS_ORIGINS=https://app.example.com

# ── Limits & cost ─────────────────────────────────────────
# DAILY_TOKEN_BUDGET=2000000         # per firm per day; 0 = unlimited
# RATE_LIMIT_QUERY_PER_MIN=20
# LLM_TIMEOUT_SECONDS=30

# ── Data retention ────────────────────────────────────────
# STORE_QUERY_TEXT=false
# RETENTION_QUERY_LOG_DAYS=90
# RETENTION_AUDIT_DAYS=365

# ── docker-compose only ───────────────────────────────────
# POSTGRES_PASSWORD=change-me
